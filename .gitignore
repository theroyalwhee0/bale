# Ignore everything by default
*

# Whitelist project files.
!.gitignore
!Cargo.lock
!Cargo.toml
!CLAUDE.md
!README.md
!.markdownlintrc
!clippy.toml

# Whitelist source files.
!build.rs
!src/
!src/**/
!src/**/*.rs

# Whitelist documentation files.
!docs/
!docs/**/
!docs/**/*.md

# Whitelist test files.
!tests/
!tests/**/
!tests/**/*.bale
!tests/**/*.md
!tests/**/*.rs
!tests/**/*.stderr
!tests/**/*.stdout
!tests/**/*.toml
!tests/**/*.sh
